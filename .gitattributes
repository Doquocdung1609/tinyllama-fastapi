# Auto detect text files and perform LF normalization
* text=auto

# Frozen scientific artifacts must retain byte-identical hashes on Windows.
docs/topic3/MILESTONE_C*.json text eol=lf
reports/milestone_c*.json text eol=lf
scripts/evaluate_persistent_financial.py text eol=lf
scripts/benchmark_financial_hardening.py text eol=lf
docs/topic3/milestone_d/recovery/p11/p11_partition_manifest.json text eol=lf
docs/topic3/milestone_d/recovery/p11/p11_adaptive_policy_v1.json text eol=lf
docs/topic3/milestone_d/recovery/p11/p11_execution_manifest.json text eol=lf
docs/topic3/milestone_d/recovery/p11/p11_gate_ledger.json text eol=lf

# Search V2 labels are canonical UTF-8/LF; result snapshots retain their measured byte hashes.
docs/search_v2/SEARCH_BENCHMARK_QRELS.jsonl text eol=lf
docs/search_v2/*.json -text whitespace=cr-at-eol
docs/search_v2/archive/**/*.txt text eol=lf

# Keep Search V3 measured labels, component fingerprints and report bytes intact across hosts.
docs/search_v3/** -text whitespace=cr-at-eol

# V3R measured source and freeze evidence retain exact bytes.
docs/search_v3r/** -text whitespace=cr-at-eol
docs/search_v3r2/** -text whitespace=cr-at-eol

# V7A G2 frozen question exports and blind packages must retain exact bytes.
docs/topic3_v7a_g2/** -text whitespace=cr-at-eol

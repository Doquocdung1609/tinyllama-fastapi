OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
JINA_MODEL=jinaai/jina-embeddings-v2-base-en

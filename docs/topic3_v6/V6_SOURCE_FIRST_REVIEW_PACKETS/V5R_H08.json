  "source_first_prose_candidates": [
    {
      "kind": "SEC_HTML_PROSE",
      "node_index_zero_based": 1154,
      "score": 20,
      "matched_terms": [
        "income",
        "operating"
      ],
      "text": "We earn a significant amount of our operating income outside the U.S. A change in the mix of earnings and losses in countries with differing statutory tax rates, changes in our business or structure, or the expiration of or disputes about certain tax agreements in a particular country may result in higher effective tax rates for the company. In addition, changes in U.S. federal and state or international tax laws applicable to corporate multinationals, other global fundamental law changes currently being considered by many countries, including in the U.S., and changes in taxing jurisdictions’ administrative interpretations, decisions, policies, and positions may materially adversely affect our financial condition and results of operations."
    },
    {
      "kind": "SEC_HTML_PROSE",
      "node_index_zero_based": 1997,
      "score": 20,
      "matched_terms": [
        "income",
        "operating"
      ],
      "text": "Adjusted gross margin, operating income, net income, and diluted earnings per share (“EPS”) are non-GAAP financial measures. Prior year non-GAAP financial measures exclude the impact of a $1.2 billion charge in the second quarter of fiscal year 2023 (“Q2 charge”), which included employee severance expenses, impairment charges resulting from changes to our hardware portfolio, and costs related to lease consolidation activities. Refer to the Non-GAAP Financial Measures section below for a reconciliation of our financial results reported in accordance with GAAP to non-GAAP financial results."
    },
    {
      "kind": "SEC_HTML_PROSE",

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
JINA_MODEL=jinaai/jina-embeddings-v2-base-en
QDRANT_URL=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=knowledgebase
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_DIR=./tools/tessdata
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=3
SCORE_THRESHOLD=0.55
MAX_UPLOAD_MB=50
MIN_FREE_DISK_MB=256
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
TTS_OUTPUT_DIR=./audio
IMAGE_OUTPUT_DIR=./images
VIDEO_OUTPUT_DIR=./videos
IMAGE_MODEL=./models/tiny-sd
VIDEO_MODEL=stabilityai/stable-video-diffusion-img2vid-xt

# Optional local CPU Cross-Encoder for Topic 3. Blank => disabled; no silent model download.
FINANCIAL_RERANKER_PATH=

# SEC EDGAR ingestion is disabled until this identifies the app and a real contact email.
# Example format only: MyResearchApp my-real-contact@example.edu
SEC_USER_AGENT=
SEC_REQUESTS_PER_SECOND=6
SEC_TIMEOUT_SECONDS=30
SEC_MAX_RETRIES=3
SEC_MAX_FILING_MB=100
FINANCIAL_CORPUS_DIR=./financial_corpus
FINANCIAL_REGISTRY_DB=./financial_corpus/registry.sqlite3
FINANCIAL_STAGING_COLLECTION=financial_staging
# Separate persistent SEC lexical/dense generations; never point at legacy Qdrant data.
FINANCIAL_INDEX_PATH=./financial_search_data
# Optional remote Qdrant server for the financial index. Blank uses single-owner embedded storage.
FINANCIAL_INDEX_QDRANT_URL=

# Financial-index mutations are denied by default. Use a long random token and send
# `Authorization: Bearer <token>`. The local override is opt-in and loopback-only.
FINANCIAL_INDEX_ADMIN_TOKEN=
FINANCIAL_INDEX_ALLOW_LOCAL_MUTATIONS=false
FINANCIAL_INDEX_MAX_REQUEST_BYTES=16384
FINANCIAL_INDEX_MAX_PENDING_BUILDS=2
FINANCIAL_INDEX_FORCE_REBUILD_COOLDOWN_SECONDS=60
FINANCIAL_INDEX_RETAINED_READY=3
FINANCIAL_INDEX_ROLLBACK_GENERATIONS=1
FINANCIAL_INDEX_PROVENANCE_CACHE_ENTRIES=8
FINANCIAL_INDEX_PROVENANCE_CACHE_MB=128
OLLAMA_IDENTITY_TIMEOUT_SECONDS=10
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=300
